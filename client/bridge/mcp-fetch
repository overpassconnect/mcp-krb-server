#!/bin/sh
# mcp-fetch - the former name of krb-fetch, kept so that nothing which learned
# it breaks: shell history, notes, scripts, and the PATH link an earlier install
# made. It runs the krb-fetch beside it and nothing else, so the two cannot
# drift. New material should say krb-fetch.
#
# Invoked through a link (/usr/local/bin/mcp-fetch points here), $0 names the
# link rather than this file, so it is resolved before the sibling is looked up.
# The sibling is run through sh rather than executed, like every script in this
# kit: a checkout carries no execute bits, only an install does.
self="$0"
if [ -L "$self" ]; then
    self="$(readlink -f "$self" 2>/dev/null || readlink "$self")"
fi
exec sh "$(dirname "$self")/krb-fetch" "$@"
